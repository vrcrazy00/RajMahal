# ==============================================================================
# REAL ESTATE BROKER PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=production

# JWT Authentication Secret Key (Generate a random 64-char string in production)
JWT_SECRET=apex-landmark-broker-production-secret-jwt-key-2026

# Database File Path (Defaults to server/data/realestate.sqlite if omitted)
DB_PATH=./server/data/realestate.sqlite

# Media Upload Directory (Defaults to server/uploads if omitted)
UPLOAD_DIR=./server/uploads
